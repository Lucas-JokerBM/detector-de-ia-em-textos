# Copie para .env e ajuste. Nunca versione o .env real.
DETECTOR_HOST=0.0.0.0
DETECTOR_PORT=8000
DETECTOR_WORKERS=2
# Chaves de API separadas por vírgula (vazio = sem autenticação; use só em rede local)
DETECTOR_API_KEYS=troque-por-uma-chave-longa-e-aleatoria
DETECTOR_RATE_LIMIT_PER_MINUTE=30
DETECTOR_MAX_UPLOAD_MB=5
DETECTOR_CORS_ORIGINS=
DETECTOR_ENABLE_DOCS=false
DETECTOR_LOG_LEVEL=INFO
# Opcional: sobrescreve pesos dos analisadores (JSON)
# DETECTOR_WEIGHTS={"phrases":0.3,"sentence_variation":0.2}
